{
  "name": "quickticketai-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E tests for QuickTicketAI",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ci": "CI=true playwright test",
    "test:debug": "playwright test --headed --workers=1",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://dev.quickticketai.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
