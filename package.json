{
  "name": "quickticketai-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E tests for QuickTicketAI",
  "scripts": {
    "test": "playwright test",
    "test:admin": "playwright test --project=admin --project=admin-login",
    "test:manager": "playwright test --project=manager --project=manager-login",
    "test:technician": "playwright test --project=technician --project=technician-login",
    "test:e2e": "playwright test --project=full-flow --workers=2",
    "test:e2e:headed": "playwright test --project=full-flow --workers=1 --headed",
    "test:headed": "playwright test --headed",
    "test:ci": "CI=true playwright test",
    "test:debug": "playwright test --headed --workers=1",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://dev.quickticketai.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
